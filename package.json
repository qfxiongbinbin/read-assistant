{
  "name": "readassistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simplify hard foreign text into easier foreign text. Monolingual, no translation.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "compile": "wxt prepare && tsc --noEmit",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=tmp/selftest.mjs --log-level=warning && node tmp/selftest.mjs",
    "gen:freq": "node scripts/gen-freq.mjs",
    "gen:ipa": "node scripts/gen-ipa.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wxt": "^0.21.4"
  },
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "language-learning",
    "english-learning",
    "text-simplification",
    "deepseek",
    "wxt",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "BrianX <qfxiongbin@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qfxiongbinbin/read-assistant.git"
  },
  "homepage": "https://github.com/qfxiongbinbin/read-assistant#readme",
  "bugs": {
    "url": "https://github.com/qfxiongbinbin/read-assistant/issues"
  }
}
